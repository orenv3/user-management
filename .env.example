# Copy to .env and fill in real values (never commit .env).

# Required for app startup (Base64). Generate: openssl rand -base64 32
JWT_SECRET=your-base64-secret-here

# Required when using dev-seed profile (both admins + demo users)
SEED_ADMIN1_NAME=private-admin # no one should see this name
SEED_ADMIN1_EMAIL=your-private-admin@example.com # no one should see this email
SEED_ADMIN1_PASSWORD=change-me-admin1 # no one should see this password

SEED_ADMIN2_NAME=admin
SEED_ADMIN2_EMAIL=admin@example.com
SEED_ADMIN2_PASSWORD=change-me-admin2

SEED_USER1_NAME=user
SEED_USER1_EMAIL=user@example.com
SEED_USER1_PASSWORD=change-me-user1

SEED_USER2_NAME=user2
SEED_USER2_EMAIL=user2@example.com
SEED_USER2_PASSWORD=change-me-user2

# --- Frontend (Vite build; restart dev server or rebuild Docker image after changes) ---

# Redact this email in the UI (match SEED_ADMIN1_EMAIL)
VITE_PRIVATE_ADMIN_EMAIL=your-private-admin@example.com

# Pre-fill login + register forms (match SEED_USER1_* and SEED_ADMIN2_*)
VITE_SEED_USER_NAME=user
VITE_SEED_USER_EMAIL=user@example.com
VITE_SEED_USER_PASSWORD=change-me-user1

VITE_SEED_ADMIN_NAME=admin
VITE_SEED_ADMIN_EMAIL=admin@example.com
VITE_SEED_ADMIN_PASSWORD=change-me-admin2

# Optional: demo walkthrough on login page (YouTube or local /demo.mp4)
VITE_DEMO_VIDEO_URL=https://youtu.be/4f4ND3ctlD8

# Optional: "About this project" link on login page
# VITE_PROJECT_REPO_URL=https://github.com/your-username/user-management
